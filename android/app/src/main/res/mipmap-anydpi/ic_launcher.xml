<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (minSdk 28 > 26, so no legacy PNG mipmaps are needed). The artwork lives in
     drawable-nodpi/ic_launcher_art.png (not @mipmap/ic_launcher, which would be a self-reference). The 17.5%
     inset keeps the hexagon inside the 66dp adaptive safe zone. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_art"
            android:inset="17.5%" />
    </foreground>
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
